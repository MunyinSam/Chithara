# Copy this file to .env and fill in real values before running docker compose

# Django
SECRET_KEY=your-secret-key-here
SUNO_API_KEY=your-suno-api-key

# ngrok — optional. When set, Suno will push results via callback (faster).
# Without it, the app falls back to polling record-info on each frontend request.
# Get your auth token at https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your-ngrok-authtoken
NGROK_URL=https://your-ngrok-subdomain.ngrok-free.app
SUNO_CALLBACK_URL=https://your-ngrok-subdomain.ngrok-free.app/api/generate/callback/

ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=chithara
DB_USER=chithara
DB_PASSWORD=chithara

# Next.js / NextAuth
AUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
