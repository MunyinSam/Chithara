      "link": null,
      "locked": false,
      "text": "RealSunoService\n──────────────────────────\nCalls actual Suno API\nSUNO_API_KEY, SUNO_API_BASE_URL\nfrom Django settings\n\nPOST  /api/v1/generate\nGET   /api/v1/generate/record-info\nGET   /api/v1/generate/credit",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "RealSunoService\n──────────────────────────\nCalls actual Suno API\nSUNO_API_KEY, SUNO_API_BASE_URL\nfrom Django settings\n\nPOST  /api/v1/generate\nGET   /api/v1/generate/record-info\nGET   /api/v1/generate/credit",
      "lineHeight": 1.25,
      "baseline": 11
    },
