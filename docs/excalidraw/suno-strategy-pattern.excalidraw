      "link": null,
      "locked": false,
      "text": "SunoContext\n──────────────────────────────────────\n_real: RealSunoService\n_mock: MockSunoService\n_credit_threshold: int  (default: 14)\n──────────────────────────────────────\n_select() → chooses active strategy\nsubmit_generation()\nfetch_task_result()\nfetch_credits()",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SunoContext\n──────────────────────────────────────\n_real: RealSunoService\n_mock: MockSunoService\n_credit_threshold: int  (default: 14)\n──────────────────────────────────────\n_select() → chooses active strategy\nsubmit_generation()\nfetch_task_result()\nfetch_credits()",
      "lineHeight": 1.25,
      "baseline": 11
    },
